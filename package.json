{
  "name": "la-mar-backend",
  "version": "1.0.0",
  "private": true,
  "description": "API de La Mar: autenticación del panel de administración y CRUD del catálogo de artículos.",
  "main": "src/server.js",
  "type": "commonjs",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "seed:admin": "node scripts/createAdmin.js",
    "cleanup": "node scripts/cleanup.js",
    "images:check": "node scripts/checkImages.js",
    "images:optimize": "node scripts/optimizeImages.js",
    "lint": "eslint src scripts",
    "test": "mocha test/**/*.test.js",
    "test:watch": "nodemon --exec \"npm test\"",
    "audit": "node scripts/audit.js",
    "audit:fix": "node scripts/audit.js && node src/server.js",
    "start:port": "PORT=3001 node src/server.js",
    "fix:port": "node scripts/fixPort.js --restart",
    "health": "curl -s http://localhost:3000/api/health | node -e \"process.stdin.on('data', d => console.log(JSON.parse(d.toString())))\"",
    "test:integration": "node --test test/integration/*.test.cjs"
  },
  "dependencies": {
    "@google-cloud/storage": "^8.2.0",
    "bcrypt": "^6.0.0",
    "celebrate": "^16.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-rate-limit": "^8.7.1",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.0",
    "multer": "^2.0.0",
    "sharp": "^0.35.5",
    "validator": "^13.15.35",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "chai": "^6.3.0",
    "chai-http": "^5.1.2",
    "eslint": "^8.57.1",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-plugin-import": "^2.32.0",
    "mocha": "^12.0.3",
    "nodemon": "^3.1.14",
    "sinon": "^22.1.0"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
