# OBLIGATORIAS
MONGODB_URI=mongodb://localhost:27017/la_mar
JWT_SECRET=tu_clave_secreta_muy_segura_de_32_caracteres_o_mas

# Administrador (local)
ADMIN_EMAIL=admin@lamar.com
ADMIN_NAME=Admin
ADMIN_PASSWORD=lamar2026

# Node.js
NODE_ENV=development

# CORS - orígenes permitidos (separados por coma). En desarrollo cualquier http://localhost:<puerto>
# ya está permitido; aquí solo hace falta en producción (p. ej. https://admin.lamarjoyeria.mooo.com).
ALLOWED_ORIGINS=

# Google Cloud Storage (opcional para desarrollo local)
GCS_BUCKET_NAME=nombre_del_bucket
GOOGLE_APPLICATION_CREDENTIALS=/ruta/absoluta/a/service-account-key.json

# Papelera - días de retención antes de borrar definitivamente
TRASH_RETENTION_DAYS=30

# Puerto (opcional)
PORT=3000

# Logs (opcional)
LOG_LEVEL=info
