# OBLIGATORIAS
MONGODB_URI=mongodb://localhost:27017/la_mar
JWT_SECRET=

# Correos de administradores (separados por coma)
ADMIN_EMAILS=darelisbatistag@gmail.com,enmanuel676hd@gmail.com

# Administrador (local)
ADMIN_EMAIL=admin@lamar.com
ADMIN_NAME=Admin
ADMIN_PASSWORD=lamar2026

# Node.js
NODE_ENV=development

# CORS - orígenes permitidos (separados por coma). En desarrollo cualquier http://localhost:<puerto>
# ya está permitido; aquí solo hace falta en producción (p. ej. https://admin.lamarjoyeria.mooo.com).
ALLOWED_ORIGINS=

# Google Cloud Storage (opcional para desarrollo local)
GCS_BUCKET_NAME=nombre_del_bucket
# En Compute Engine se usa la cuenta de servicio de la VM (ADC).
# Solo fuera de Google Cloud, si necesitas un archivo de credenciales:
# GOOGLE_APPLICATION_CREDENTIALS=/ruta/absoluta/a/service-account-key.json
GCS_PROJECT_ID=

# Papelera - días de retención antes de borrar definitivamente
TRASH_RETENTION_DAYS=30

# Puerto (opcional)
PORT=3000
HOST=127.0.0.1
TRUST_PROXY=loopback

# Logs (opcional)
LOG_LEVEL=info

# Duración de sesión
JWT_EXPIRES_IN=12h
